{
  "name": "peruzzi-inferno",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "api": "npm run start:dev -w apps/api",
    "web": "npm run dev -w apps/web",
    "seed": "npm run seed -w apps/api",
    "e2e": "node apps/web/scripts/stage.e2e.mjs && node apps/web/scripts/send.e2e.mjs && node apps/web/scripts/admin.e2e.mjs"
  }
}
