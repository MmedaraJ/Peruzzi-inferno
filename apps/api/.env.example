# Copy to apps/api/.env for local runs. On Railway, set these on the service instead.
DATABASE_URL=postgresql://user:pass@localhost:5432/peruzzi
PORT=4000
# the site's own address (links in emails and previews point here) and the API's
WEB_URL=https://peruzzi-asked.example.com
API_URL=https://peruzzi-inferno-api.up.railway.app
SITE_NAME=peruzzi-asked.example.com
# the admin's password (/admin)
ADMIN_PASSWORD=change-me
# signs the admin's sign-in sessions (optional): unset, a key made from ADMIN_PASSWORD does, so a new password signs
# everyone out
ADMIN_SESSION_SECRET=
# keys the opt-out list and signs the opt-out links and senders' tokens (unset, ADMIN_PASSWORD does). Before you ever
# change ADMIN_PASSWORD, set HASH_SECRET to its current value if it isn't set yet: what the old password keyed would
# stop matching, so people who opted out could be emailed again and the links already sent would stop working.
HASH_SECRET=
# Peruzzi's lines: he reads each note in one call (PERUZZI_MODEL changes the model; PERUZZI_SPEED=fast runs Opus in
# fast mode, about twice as quick at twice the price)
ANTHROPIC_API_KEY=
PERUZZI_MODEL=claude-opus-5-5
PERUZZI_SPEED=
# the voice (optional): ElevenLabs. ELEVENLABS_VOICE_ID is Peruzzi's voice, for "Peruzzi's AI voice" only
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MC_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# email (optional): Resend. Until a key is set, the site hides everything that sends email.
# MAIL_DRY_RUN=1 (local only) logs emails instead and keeps them in GET /api/admin/outbox
RESEND_API_KEY=
MAIL_DRY_RUN=
MAIL_FROM="Peruzzi Asked <notes@your-domain.com>"
MAIL_REPLY_TO=
# the most emails the site sends in an hour, all kinds together (300 unless set): codes and tracklists go to any address
# typed in, so this holds the Resend bill whatever anyone asks for
MAIL_PER_HOUR=
